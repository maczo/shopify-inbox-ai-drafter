# Copy to .env.local and fill in.
# Get an OpenRouter key at https://openrouter.ai/keys

OPENROUTER_API_KEY=

# Free models only. Anything without the :free suffix is rejected at startup.
OPENROUTER_DRAFTER_MODEL=nvidia/nemotron-3.5-super-vl:free
FALLBACK_MODELS=baidu/ernie-5.5-flash-preview:free,inclusionai/ling-3.2-flash:free

# PostHog pilot. Project key is read from the environment and never committed.
# US Cloud host is https://us.i.posthog.com (EU is https://eu.i.posthog.com).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
