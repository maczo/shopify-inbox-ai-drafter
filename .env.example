# Copy to .env.local and fill in.
# Get a key at https://openrouter.ai/keys

OPENROUTER_API_KEY=

# Free models only. Anything without the :free suffix is rejected at startup.
DRAFTER_MODEL=nvidia/nemotron-3.5-super-vl:free
FALLBACK_MODELS=baidu/ernie-5.5-flash-preview:free,inclusionai/ling-3.2-flash:free

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
